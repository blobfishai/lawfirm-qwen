#!/usr/bin/env python3
"""Firm-systems tool CLI (agent container).

Usage:
  tool list                       # every tool: name + one-line description
  tool schema <name>              # full input schema for one tool
  tool call <name> '<json-args>'  # call a tool, e.g.
                                  #   tool call documents_download '{"id": 12}'

Exit code 1 when the call returns an error (transient `rate_limited` /
`stale_reference` errors are recoverable: retry the same call).
"""
import json
import os
import sys
import urllib.request

BASE = os.environ.get("LAWFIRM_MCP", "http://world:8972/mcp")


def rpc(method: str, params: dict):
    req = urllib.request.Request(BASE, method="POST")
    req.add_header("Content-Type", "application/json")
    body = json.dumps({"jsonrpc": "2.0", "id": 1,
                       "method": method, "params": params}).encode()
    with urllib.request.urlopen(req, data=body, timeout=120) as res:
        out = json.loads(res.read().decode() or "{}")
    if out.get("error"):
        sys.exit(f"ERROR: {out['error'].get('message')}")
    return out.get("result") or {}


def main() -> None:
    argv = sys.argv[1:]
    if not argv or argv[0] not in ("list", "schema", "call"):
        sys.exit(__doc__.strip())
    if argv[0] == "list":
        for t in rpc("tools/list", {}).get("tools", []):
            desc = (t.get("description") or "").split(". ")[0][:110]
            print(f"{t['name']}  —  {desc}")
        return
    if argv[0] == "schema":
        if len(argv) < 2:
            sys.exit("usage: tool schema <name>")
        for t in rpc("tools/list", {}).get("tools", []):
            if t["name"] == argv[1]:
                print(json.dumps(t, indent=2))
                return
        sys.exit(f"unknown tool {argv[1]!r}")
    # call
    if len(argv) < 2:
        sys.exit("usage: tool call <name> '<json-args>'")
    try:
        args = json.loads(argv[2]) if len(argv) > 2 else {}
    except json.JSONDecodeError as e:
        sys.exit(f"arguments must be a JSON object: {e}")
    r = rpc("tools/call", {"name": argv[1], "arguments": args})
    print("".join(c.get("text", "") for c in r.get("content", [])))
    if r.get("isError"):
        sys.exit(1)


if __name__ == "__main__":
    main()
