{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legal-agent-simulation.local/schemas/task-manifest-v1.json",
  "title": "Manifest-first deterministic legal task",
  "type": "object",
  "required": ["schema_version", "manifest_id", "task", "facts", "documents", "determinations"],
  "properties": {
    "schema_version": {"const": 1},
    "manifest_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "seed": {"type": "integer"},
    "task": {
      "type": "object",
      "required": ["instruction", "deliverables"],
      "properties": {
        "instruction": {"type": "string", "minLength": 20},
        "deliverables": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "workflow": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "value", "placements"],
        "properties": {
          "id": {"type": "string"},
          "kind": {"enum": ["string", "money", "number", "integer", "percentage", "date", "section", "citation", "category"]},
          "value": {},
          "variants": {"type": "array", "items": {"type": ["string", "number"]}},
          "required_in_output": {"type": "boolean"},
          "placements": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "required": ["document"],
              "properties": {"document": {"type": "string"}, "min_count": {"type": "integer", "minimum": 1}, "max_count": {"type": "integer", "minimum": 1}}
            }
          }
        }
      }
    },
    "documents": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "filename", "title", "sections"],
        "properties": {
          "id": {"type": "string"},
          "filename": {"type": "string", "pattern": "^[^/]+\\.(txt|md|docx)$"},
          "title": {"type": "string"},
          "sections": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "required": ["heading", "paragraphs"],
              "properties": {"heading": {"type": "string"}, "paragraphs": {"type": "array", "items": {"type": "string"}}}
            }
          }
        }
      }
    },
    "planted_inconsistencies": {
      "type": "array",
      "items": {"type": "object", "required": ["id", "left_fact", "right_fact"], "properties": {"id": {"type": "string"}, "left_fact": {"type": "string"}, "right_fact": {"type": "string"}}}
    },
    "distractors": {
      "type": "array",
      "items": {"type": "object", "required": ["id", "kind", "value"], "properties": {"id": {"type": "string"}, "kind": {"type": "string"}, "value": {}, "documents": {"type": "array", "items": {"type": "string"}}}}
    },
    "determinations": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["id", "type"], "properties": {"id": {"type": "string"}, "type": {"enum": ["grounded_values", "issue_set", "computation", "abstention"]}, "fact_ids": {"type": "array", "items": {"type": "string"}}, "anchor_sets": {"type": "array", "items": {"type": "array", "items": {"type": "string"}}}, "veto": {"type": "boolean"}}}
    },
    "absences": {
      "type": "array",
      "items": {"type": "object", "required": ["id", "label"], "properties": {"id": {"type": "string"}, "label": {"type": "string"}, "forbidden_values": {"type": "array", "items": {"type": ["string", "number"]}}}}
    }
  },
  "additionalProperties": false
}
