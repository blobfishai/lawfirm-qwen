{
 "$schema": "lawfirm-qwen.mcp-contract.v2",
 "system": "workspace-v2",
 "product": "Fieldstone Workspace (SIMULATED) \u2014 API surface mirrors Google Workspace (Sheets/Drive/Gmail/Calendar)",
 "provenance": "https://developers.google.com/sheets/api | drive/api | gmail/api | calendar/api",
 "tables": [
  {
   "name": "ws_spreadsheets",
   "columns": [
    {
     "name": "id",
     "type": "INTEGER",
     "pk": true
    },
    {
     "name": "title",
     "type": "TEXT"
    },
    {
     "name": "owner",
     "type": "TEXT"
    }
   ],
   "seed": {
    "count": 6,
    "template": {
     "title": "@pick:Matter Budget Tracker,Litigation Deadlines Master,Billable Hours Q3,Settlement Model,Closing Checklist,Conflicts Intake Log",
     "owner": "@person"
    }
   }
  },
  {
   "name": "ws_sheet_values",
   "columns": [
    {
     "name": "id",
     "type": "INTEGER",
     "pk": true
    },
    {
     "name": "spreadsheet_id",
     "type": "INTEGER"
    },
    {
     "name": "sheet_name",
     "type": "TEXT"
    },
    {
     "name": "cell_range",
     "type": "TEXT"
    },
    {
     "name": "value",
     "type": "TEXT"
    }
   ],
   "seed": {
    "count": 80,
    "template": {
     "spreadsheet_id": "@ref:ws_spreadsheets",
     "sheet_name": "@pick:Sheet1,Summary,Q3,Detail",
     "cell_range": "@cell",
     "value": "@sheet_value"
    }
   }
  },
  {
   "name": "ws_files",
   "columns": [
    {
     "name": "id",
     "type": "INTEGER",
     "pk": true
    },
    {
     "name": "name",
     "type": "TEXT"
    },
    {
     "name": "mime_type",
     "type": "TEXT"
    },
    {
     "name": "parent_folder",
     "type": "TEXT"
    },
    {
     "name": "owner",
     "type": "TEXT"
    },
    {
     "name": "modified_at",
     "type": "TEXT"
    },
    {
     "name": "content",
     "type": "TEXT"
    }
   ],
   "seed": {
    "count": 24,
    "template": {
     "name": "@doc_name",
     "mime_type": "@pick:application/pdf,application/vnd.google-apps.document,application/vnd.openxmlformats-officedocument.wordprocessingml.document",
     "parent_folder": "@pick:Matters,Templates,Admin,Client Shares",
     "owner": "@person",
     "modified_at": "@date:2026-05-01,2026-08-01",
     "content": "@filing_text"
    }
   }
  },
  {
   "name": "ws_messages",
   "columns": [
    {
     "name": "id",
     "type": "INTEGER",
     "pk": true
    },
    {
     "name": "thread_id",
     "type": "INTEGER"
    },
    {
     "name": "from_addr",
     "type": "TEXT"
    },
    {
     "name": "to_addr",
     "type": "TEXT"
    },
    {
     "name": "subject",
     "type": "TEXT"
    },
    {
     "name": "body",
     "type": "TEXT"
    },
    {
     "name": "sent_at",
     "type": "TEXT"
    },
    {
     "name": "label",
     "type": "TEXT"
    }
   ],
   "seed": {
    "count": 40,
    "template": {
     "thread_id": "@int:1,15",
     "from_addr": "@email",
     "to_addr": "@email",
     "subject": "@comm_subject",
     "body": "@comm_body",
     "sent_at": "@date:2026-06-01,2026-08-01",
     "label": "@pick:INBOX,INBOX,SENT,IMPORTANT"
    }
   }
  },
  {
   "name": "ws_events",
   "columns": [
    {
     "name": "id",
     "type": "INTEGER",
     "pk": true
    },
    {
     "name": "calendar",
     "type": "TEXT"
    },
    {
     "name": "summary",
     "type": "TEXT"
    },
    {
     "name": "start_at",
     "type": "TEXT"
    },
    {
     "name": "end_at",
     "type": "TEXT"
    },
    {
     "name": "attendees",
     "type": "TEXT"
    },
    {
     "name": "status",
     "type": "TEXT"
    }
   ],
   "seed": {
    "count": 20,
    "template": {
     "calendar": "@pick:firm,litigation,personal",
     "summary": "@event_summary",
     "start_at": "@date:2026-08-05,2026-10-01",
     "end_at": "@date:2026-08-05,2026-10-01",
     "attendees": "@email",
     "status": "@pick:confirmed,confirmed,tentative"
    }
   }
  }
 ],
 "tools": [
  {
   "name": "sheets_values_get",
   "mirrors": "GET /v4/spreadsheets/{id}/values/{range}",
   "description": "Read values from a sheet range.",
   "op": {
    "kind": "list",
    "table": "ws_sheet_values",
    "filters": [
     "spreadsheet_id",
     "sheet_name",
     "cell_range"
    ]
   },
   "params": {
    "spreadsheet_id": "integer",
    "sheet_name": "string",
    "cell_range": "string",
    "limit": "integer"
   },
   "scenario": "The practice manager reads the Q3 billable-hours tab for the compensation meeting."
  },
  {
   "name": "sheets_values_update",
   "mirrors": "PUT /v4/spreadsheets/{id}/values/{range}",
   "description": "Write a value to a cell/range.",
   "op": {
    "kind": "create",
    "table": "ws_sheet_values",
    "required": [
     "spreadsheet_id",
     "sheet_name",
     "cell_range",
     "value"
    ]
   },
   "params": {
    "spreadsheet_id": "integer",
    "sheet_name": "string",
    "cell_range": "string",
    "value": "string"
   },
   "scenario": "After the bill issues, the clerk updates the matter-budget tracker cell."
  },
  {
   "name": "spreadsheets_list",
   "mirrors": "Drive files.list mimeType=spreadsheet",
   "description": "List spreadsheets.",
   "op": {
    "kind": "list",
    "table": "ws_spreadsheets",
    "filters": [
     "owner"
    ]
   },
   "params": {
    "owner": "string",
    "limit": "integer"
   },
   "scenario": "The ops manager inventories the firm's tracking spreadsheets during systems cleanup."
  },
  {
   "name": "drive_files_list",
   "mirrors": "GET /drive/v3/files?q=",
   "description": "List/search Drive files.",
   "op": {
    "kind": "search",
    "table": "ws_files",
    "fields": [
     "name",
     "parent_folder",
     "owner"
    ]
   },
   "params": {
    "query": "string",
    "limit": "integer"
   },
   "scenario": "An associate searches the client share for the security questionnaire."
  },
  {
   "name": "drive_files_get",
   "mirrors": "GET /drive/v3/files/{id}?alt=media",
   "description": "Fetch a file with content.",
   "op": {
    "kind": "get",
    "table": "ws_files"
   },
   "params": {
    "id": "integer"
   },
   "scenario": "She opens the questionnaire to copy the firm's standard answers."
  },
  {
   "name": "gmail_messages_list",
   "mirrors": "GET /gmail/v1/users/me/messages?q=",
   "description": "Search mail (subject/body/participants).",
   "op": {
    "kind": "search",
    "table": "ws_messages",
    "fields": [
     "subject",
     "body",
     "from_addr",
     "to_addr"
    ],
    "preview": [
     "body"
    ]
   },
   "params": {
    "query": "string",
    "limit": "integer"
   },
   "scenario": "Preparing the chronology, the paralegal searches mail for the settlement thread."
  },
  {
   "name": "gmail_messages_get",
   "mirrors": "GET /gmail/v1/users/me/messages/{id}",
   "description": "Fetch one message in full.",
   "op": {
    "kind": "get",
    "table": "ws_messages"
   },
   "params": {
    "id": "integer"
   },
   "scenario": "He opens the key message where the client authorized the offer."
  },
  {
   "name": "gmail_messages_send",
   "mirrors": "POST /gmail/v1/users/me/messages/send",
   "description": "Send a message (records to SENT).",
   "op": {
    "kind": "create",
    "table": "ws_messages",
    "required": [
     "from_addr",
     "to_addr",
     "subject",
     "body"
    ],
    "defaults": {
     "label": "SENT"
    }
   },
   "params": {
    "from_addr": "string",
    "to_addr": "string",
    "subject": "string",
    "body": "string",
    "thread_id": "integer",
    "sent_at": "string"
   },
   "scenario": "The associate emails the executed agreement to the client with the closing summary."
  },
  {
   "name": "calendar_events_list",
   "mirrors": "GET /calendar/v3/calendars/{id}/events",
   "description": "List events with date range.",
   "op": {
    "kind": "list",
    "table": "ws_events",
    "filters": [
     "calendar",
     "status"
    ],
    "range": {
     "field": "start_at",
     "from_param": "time_min",
     "to_param": "time_max"
    }
   },
   "params": {
    "calendar": "string",
    "status": "string",
    "time_min": "string",
    "time_max": "string",
    "limit": "integer"
   },
   "scenario": "The docketing clerk cross-checks firm calendar events against court deadlines."
  },
  {
   "name": "calendar_events_insert",
   "mirrors": "POST /calendar/v3/calendars/{id}/events",
   "description": "Create an event.",
   "op": {
    "kind": "create",
    "table": "ws_events",
    "required": [
     "calendar",
     "summary",
     "start_at"
    ],
    "defaults": {
     "status": "confirmed"
    }
   },
   "params": {
    "calendar": "string",
    "summary": "string",
    "start_at": "string",
    "end_at": "string",
    "attendees": "string"
   },
   "scenario": "The secretary schedules the all-hands closing call for Thursday."
  }
 ]
}