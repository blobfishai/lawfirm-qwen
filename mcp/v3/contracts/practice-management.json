 "tools": [
  {
   "name": "matters_list",
   "mirrors": "GET /api/v4/matters.json — https://docs.developers.clio.com/api-reference/#tag/Matters",
   "description": "List matters with filters (status, client, responsible attorney, practice area).",
   "op": {
    "kind": "list",
    "table": "pm_matters",
    "filters": [
     "status",
     "client_id",
     "responsible_attorney_id",
     "practice_area_id",
     "billing_method"
    ]
   },
   "params": {
    "status": "string",
    "client_id": "integer",
    "responsible_attorney_id": "integer",
    "practice_area_id": "integer",
    "billing_method": "string",
    "limit": "integer"
   },
   "scenario": "A supervising partner reviews all open matters in her practice area before Monday staffing."
  },
  {
   "name": "matters_get",
   "mirrors": "GET /api/v4/matters/{id}.json",
   "description": "Fetch one matter by id.",
   "op": {
    "kind": "get",
    "table": "pm_matters"
   },
   "params": {
    "id": "integer"
   },
   "scenario": "An associate pulls the matter record to confirm billing method and responsible attorney before recording time."
  },
  {
   "name": "matters_create",
   "mirrors": "POST /api/v4/matters.json",
   "description": "Open a new matter.",
   "op": {
    "kind": "create",
    "table": "pm_matters",
    "required": [
     "display_name",
     "client_id",
     "practice_area_id",
     "responsible_attorney_id"
    ],
    "defaults": {
     "status": "open"
    }
   },
   "params": {
    "display_name": "string",
    "client_id": "integer",
    "practice_area_id": "integer",
    "responsible_attorney_id": "integer",
    "billing_method": "string",
    "description": "string",
    "number": "string",
    "open_date": "string"
   },
   "scenario": "Intake coordinator opens a new matter after the engagement letter is signed and conflicts cleared."
  },
  {
   "name": "matters_update",
   "mirrors": "PATCH /api/v4/matters/{id}.json",
   "description": "Update matter fields (status transitions, staffing, description).",
   "op": {
    "kind": "update",
    "table": "pm_matters",
    "allowed": [
     "status",
     "responsible_attorney_id",
     "description",
     "close_date",
     "billing_method"
    ]
   },
   "params": {
    "id": "integer",
    "status": "string",
    "responsible_attorney_id": "integer",
    "description": "string",
    "close_date": "string",
    "billing_method": "string"
   },
   "scenario": "The responsible partner closes a settled matter and hands staffing to a new associate."
  },
  {
   "name": "matters_search",
   "mirrors": "GET /api/v4/matters.json?query=",
   "description": "Free-text search over matter number, name, description.",
   "op": {
    "kind": "search",
    "table": "pm_matters",
    "fields": [
     "number",
     "display_name",
     "description"
    ]
   },
   "params": {
    "query": "string",
    "limit": "integer"
   },
   "scenario": "A paralegal finds the right matter from a client's email that only mentions the deal name."
  },
  {
   "name": "contacts_list",
   "mirrors": "GET /api/v4/contacts.json — #tag/Contacts",
   "description": "List contacts (people and companies) with filters.",
   "op": {
    "kind": "list",
    "table": "pm_contacts",
    "filters": [
