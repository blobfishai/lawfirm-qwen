{
  "$schema": "lawfirm-qwen.mcp-systems.v1",
  "note": "The firm's tool stack, partitioned into per-system MCP servers — one server per product the firm would really run. All systems front the same world state (one firm, many frontends); true multi-storage fragmentation is a sales-world mechanic per docs/WORLD-CREATION-PLAYBOOK.md Stage 2. Tool names are globally unique, so traces stay verifier-compatible across servers.",
  "systems": {
    "practice-management": {
      "product": "LexOperis PM (SIMULATED practice-management suite; Clio-class)",
      "description": "Matter lifecycle and conflicts: matter records, conflict cases, their audit trails, and the amount-history/evidence/remediation/review workflows. Also the firm-ops assistants.",
      "tools": [
        "legal_matters_list", "legal_matters_get", "legal_matters_audit_list",
        "legal_matters_amount_history_create", "legal_matters_evidence_create",
        "legal_matters_remediation_create", "legal_matters_review_create",
        "legal_conflicts_list", "legal_conflicts_get", "legal_conflicts_audit_list",
        "legal_conflicts_amount_history_create", "legal_conflicts_evidence_create",
        "legal_conflicts_remediation_create", "legal_conflicts_review_create",
        "operations_records_agent", "operations_workflow_agent"
      ]
    },
    "litigation-docketing": {
      "product": "CourtDock (SIMULATED litigation docketing/CMS)",
      "description": "Cases, court filings, docket entries, hearings, courts, and computed deadlines — with audit trails and amount-history/evidence/remediation/review workflows per entity.",
      "tools": [
        "litigation_cases_list", "litigation_cases_get", "litigation_cases_audit_list",
        "litigation_cases_amount_history_create", "litigation_cases_evidence_create",
        "litigation_cases_remediation_create", "litigation_cases_review_create",
        "litigation_filings_list", "litigation_filings_get", "litigation_filings_audit_list",
        "litigation_filings_amount_history_create", "litigation_filings_evidence_create",
        "litigation_filings_remediation_create", "litigation_filings_review_create",
        "litigation_dockets_list", "litigation_dockets_get", "litigation_dockets_audit_list",
        "litigation_dockets_amount_history_create", "litigation_dockets_evidence_create",
        "litigation_dockets_remediation_create", "litigation_dockets_review_create",
        "litigation_hearings_list", "litigation_hearings_get", "litigation_hearings_audit_list",
        "litigation_hearings_amount_history_create", "litigation_hearings_evidence_create",
        "litigation_hearings_remediation_create", "litigation_hearings_review_create",
        "litigation_courts_list", "litigation_courts_get", "litigation_courts_audit_list",
        "litigation_courts_amount_history_create", "litigation_courts_evidence_create",
        "litigation_courts_remediation_create", "litigation_courts_review_create",
        "litigation_deadlines_list", "litigation_deadlines_get", "litigation_deadlines_audit_list",
        "litigation_deadlines_amount_history_create", "litigation_deadlines_evidence_create",
        "litigation_deadlines_remediation_create", "litigation_deadlines_review_create"
      ]
    },
    "discovery-platform": {
      "product": "DiscoParse (SIMULATED e-discovery platform; Relativity-class)",
      "description": "Discovery requests with audit trail and production-cost/evidence/remediation/review workflows.",
      "tools": [
        "litigation_discovery_list", "litigation_discovery_get", "litigation_discovery_audit_list",
        "litigation_discovery_amount_history_create", "litigation_discovery_evidence_create",
        "litigation_discovery_remediation_create", "litigation_discovery_review_create"
      ]
    },
    "billing": {
      "product": "LedgerBill (SIMULATED legal billing/e-billing)",
      "description": "Invoice reviews, billing audit trail, invoice-amount workflows, and the raw invoices ledger.",
      "tools": [
        "legal_billing_list", "legal_billing_get", "legal_billing_audit_list",
        "legal_billing_amount_history_create", "legal_billing_evidence_create",
        "legal_billing_remediation_create", "legal_billing_review_create",
        "query_invoices", "update_invoices_status"
      ]
    },
    "dms": {
      "product": "MatterVault DMS (SIMULATED document management; iManage-class)",
      "description": "The matter document repository: search (previews), full-document reads, deliverable filing, and title maintenance.",
      "tools": [
        "query_matter_documents", "read_matter_document",
        "draft_matter_document", "update_matter_documents_title"
      ]
    },
    "office-suite": {
      "product": "Fieldstone Workspace (SIMULATED office suite)",
      "description": "Working documents, spreadsheets, calendar, and file shares — the firm's general-productivity layer, separate from the DMS of record.",
      "tools": [
        "document_agent", "sheet_agent", "calendar_agent",
        "query_documents", "query_calendar_events", "query_files", "read_file"
      ]
    },
    "hr-directory": {
      "product": "StaffDesk (SIMULATED HR / staffing directory)",
      "description": "Employees, departments, work assignments, and the org-records assistants.",
      "tools": [
        "query_employees", "query_departments", "query_employee_work_assignments",
        "lookup_employee_work_assignment_with_employees",
        "update_employee_work_assignments_status", "update_employees_active",
        "update_departments_department_code",
        "organization_records_agent", "organization_workflow_agent"
      ]
    },
    "knowledge-assistant": {
      "product": "Cortex Notes (SIMULATED knowledge/memory assistant)",
      "description": "Firm memory, knowledge base, playbooks, and scheduled runs.",
      "tools": [
        "save_memory", "search_memory", "add_to_knowledge", "search_knowledge",
        "create_playbook", "list_playbooks", "create_scheduled_run", "list_scheduled_runs"
      ]
    }
  }
}
